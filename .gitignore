node_modules
cypress/screenshots
cypress/videos
cypress/downloads
cypress/reports

# Visual regression: actual/diff images are disposable per-run output.
# cypress/snapshots/base is NOT ignored - that's the committed reference baseline.
cypress/snapshots/actual
cypress/snapshots/diff
# Only commit the Linux baselines (the ones CI compares against) - screenshots
# taken on Windows/Mac render slightly differently, so keep those local.
cypress/snapshots/base/**/*.png
!cypress/snapshots/base/**/*linux*.png
.env
.env.local

# Saved login token used by ensureLoggedIn() - contains a real login, never commit it
cypress/.auth
